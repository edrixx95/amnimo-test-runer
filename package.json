{
  "name": "amnimo-test-runner",
  "version": "1.0.1",
  "description": "Amnimo Test Runner Desktop App",
  "author": {
    "name": "DAT NGUYEN THANH",
    "email": "thanhdat.nguyen@dts-insight.co.jp"
  },
  "homepage": "...",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "dev:electron": "nuxt build && electron .",
    "build:electron": "nuxt build && electron-builder"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.amnimo.testrunner",
    "productName": "Amnimo Test Runner",
    "artifactName": "${productName} ${version} Setup.${ext}",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "edrixx95",
        "repo": "amnimo-test-runer"
      }
    ],
    "files": [
      ".output/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "differentialPackage": false
    }
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.0",
    "@vueuse/core": "^12.6.0",
    "@vueuse/nuxt": "^12.6.0",
    "chart.js": "^4.5.1",
    "crossws": "^0.3.1",
    "electron-updater": "^6.8.9",
    "nuxt": "^4.4.8",
    "pinia": "^4.0.1",
    "vue": "^3.5.39",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nuxt/icon": "^2.3.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  }
}
